---
import FaqList from '../components/FaqList.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import InstallBlock from '../components/InstallBlock.astro';
import Layout from '../components/Layout.astro';
import { faqGroups, siteStrings } from '../data/site';
import type { Lang } from '../lib/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = siteStrings(lang);
const groups = faqGroups(lang);
---

<Layout lang={lang} page="faq" faq={groups.flatMap((g) => g.items.map(({ q, a }) => ({ q, a })))}>
  <Header lang={lang} page="faq" />
  <main class="page">
    <h1 class="page-h1">{t.faqPage.h1}</h1>
    <p class="doc-text page-lead">{t.faqPage.lead}</p>
    {
      groups.map((g) => (
        <section id={g.id} class="doc">
          <h2>{g.title}</h2>
          <FaqList items={g.items} />
        </section>
      ))
    }
    <section id="install" class="doc">
      <h2>{t.install.heading}</h2>
      <InstallBlock lang={lang} page="faq" cta="page_end" />
    </section>
  </main>
  <Footer lang={lang} page="faq" />
</Layout>
