---
import '../styles/stepper.css';
import { getCapture, pendingCaptures } from '../data/captures';
import { siteStrings } from '../data/site';
import { IS_RELEASE, assertReleasable } from '../lib/release';
import { screenCut, screenFocus, screenFocusLabel } from '../lib/screen-focus';
import { stepDurationMs, stepStayMs } from '../lib/stepper-state';
import type { CaseDef, CaseId, Device, Lang } from '../lib/types';
import MediaView from './MediaView.astro';
import HeroDecor from './HeroDecor.astro';
import Guide from './Guide.astro';

interface Props {
  lang: Lang;
  cases: CaseDef[];
  /** Case pages show one case and no case buttons. */
  fixedCase?: CaseId;
  detail: 'short' | 'long';
  /** Level of the case heading. Step headings sit one level below. */
  headingLevel: 2 | 3;
  /** Case pages name the case in their H1, so the heading above the steps says something else. */
  stepsHeading?: string;
}

const { lang, cases, fixedCase, detail, headingLevel, stepsHeading } = Astro.props;
const t = siteStrings(lang).stepper;
const shown = fixedCase ? cases.filter((c) => c.id === fixedCase) : cases;
const CaseHeading = `h${headingLevel}`;
const StepHeading = `h${headingLevel + 1}`;
const DEVICES: Device[] = ['phone', 'tablet'];
assertReleasable(pendingCaptures(), IS_RELEASE);
// The home page starts at a random case, so no image can be marked "first" in the HTML. This runs as
// soon as the stepper is parsed and asks for the chosen case's first screen right away.
const firstScreen = `(function(){var c=document.documentElement.dataset.startCase;if(!c)return;var i=document.querySelector('[data-stepper] figure[data-media][data-case="'+c+'"][data-step="create"][data-device="phone"] img');if(i){i.loading='eager';i.fetchPriority='high';i.setAttribute('fetchpriority','high')}})();`;
---

{/* Every case, step and screen is in the HTML. The script only switches which one is shown. */}
<section id="cases" class="stepper" data-stepper data-fixed-case={fixedCase} data-detail={detail} aria-label={t.sectionLabel}>
  {Astro.slots.has('lead') && <div class="stepper-lead"><slot name="lead" /><HeroDecor /></div>}

  {
    !fixedCase && (
      <div class="stepper-tabs" role="group" aria-label={t.casesLabel}>
        {shown.map((c) => (
          <button type="button" data-track="case_select" data-case={c.id} aria-pressed="false">
            {c.tab}
          </button>
        ))}
      </div>
    )
  }

  <div class="stepper-switch" role="group" aria-label={t.deviceLabel}>
    <button type="button" data-action="device" data-device="phone" aria-pressed="true">{t.phone}</button>
    <button type="button" data-action="device" data-device="tablet" aria-pressed="false">{t.tablet}</button>
  </div>

  {
    shown.map((c, caseIndex) => (
      <article data-case={c.id}>
        <div class="case-screens">
          <Guide pose="done" line={c.guideLine} size="lg" />
          {c.steps.flatMap((s, stepIndex) =>
            DEVICES.map((device) => {
              const entry = getCapture(lang, c.id, device, s.id);
              const focus = screenFocus(c.id, s.id);
              return (
                <figure
                  data-media
                  data-case={c.id}
                  data-step={s.id}
                  data-device={device}
                  data-focus={screenFocusLabel(focus)}
                  data-cut={screenCut(focus)}
                  style={`--show: ${focus.show}; --focus-y: ${focus.at}%`}
                  data-duration={detail === 'long' ? stepStayMs(entry.media, s.long) : stepDurationMs(entry.media)}
                  data-active={stepIndex === 0 && device === 'phone' ? '' : undefined}
                  aria-labelledby={`step-${c.id}-${s.id}`}
                >
                  <MediaView entry={entry} device={device} eager={Boolean(fixedCase) && caseIndex === 0 && stepIndex === 0 && device === 'phone'} />
                  {entry.status === 'final' && (
                    <button type="button" class="media-zoom" data-action="zoom" aria-haspopup="dialog">
                      {t.zoom}
                    </button>
                  )}
                </figure>
              );
            }),
          )}
        </div>
        <div class="case-text">
          <CaseHeading class="case-name">{stepsHeading ?? c.name}</CaseHeading>
          <ol data-steps>
            {c.steps.map((s, stepIndex) => (
              <li data-step={s.id} data-active={stepIndex === 0 ? '' : undefined}>
                <div class="step-cell">
                  <StepHeading class="step-title" id={`step-${c.id}-${s.id}`}>
                    <button type="button" aria-current={stepIndex === 0 ? 'step' : 'false'}>
                      {s.title}
                    </button>
                  </StepHeading>
                  <p class="step-text">{detail === 'long' ? s.long : s.short}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </article>
    ))
  }

  {/* A phone shows one step at a time, so it needs a way to move between them. Hidden on wider screens,
      where the whole list is on view and each step is its own button. */}
  <div class="step-nav" data-step-nav role="group" aria-label={t.stepNavLabel}>
    <button type="button" data-action="step-prev" aria-label={t.prevStep}>&lsaquo;</button>
    <p class="step-count"><span data-step-now>1</span> / {shown[0].steps.length}</p>
    <button type="button" data-action="step-next" aria-label={t.nextStep}>&rsaquo;</button>
  </div>

  <p class="stepper-note">
    <span class="stepper-frame-label" data-frame-label></span>
    <span>{t.androidNote}</span>
  </p>

  <div class="stepper-controls">
    <button type="button" data-action="toggle-pause" aria-pressed="false" data-label-pause={t.pause} data-label-resume={t.resume}>
      {t.pause}
    </button>
  </div>

  {Astro.slots.has('cta') && <div class="stepper-cta"><slot name="cta" /></div>}

  {/* One window per stepper. It is empty until a screen is opened in it, so it adds no picture to the page. */}
  <dialog class="zoom" data-zoom aria-labelledby="zoom-title">
    <div class="zoom-bar">
      <p class="zoom-title" id="zoom-title" data-zoom-title></p>
      <button type="button" data-action="zoom-close" autofocus>{t.zoomClose}</button>
    </div>
    <div class="zoom-body" data-zoom-body tabindex="0" role="group" aria-labelledby="zoom-title"></div>
  </dialog>
</section>
{!fixedCase && <script is:inline set:html={firstScreen} />}

<script>
  import { mountSteppers } from './case-stepper.client';

  mountSteppers();
</script>
