---
import '../styles/decor.css';

// Soft timetable blocks around the first screen (redesign 11-20). Decorative only.
// Wide screens: (x, y) on the stage card, in its strips left and right of the phone (the phone covers x 112–408)
// and above or below where the tablet sits (y 183–493), so neither device, Simgani nor its bubble is covered.
// Narrow screens: the first three, at mx in the band under the lead. Colours are timetable cell colours;
// cl/cd are the colour mixed 45% with white and 8% with black (precomputed: old Safari cannot read color-mix()).
const BLOCKS = [
  { c: '#88c8fe', cl: '#BEE1FE', cd: '#7DB8EA', w: 56, h: 38, r: -8, x: 40, y: 84, mx: '6%', mw: 34, mh: 22 },
  { c: '#ffc252', cl: '#FFDDA0', cd: '#EBB24B', w: 46, h: 30, r: 10, x: 58, y: 144, mx: '41%', mw: 30, mh: 20 },
  { c: '#a5db81', cl: '#CEEBBA', cd: '#98C977', w: 60, h: 40, r: 8, x: 424, y: 520, mx: '76%', mw: 36, mh: 24 },
  { c: '#fda1e4', cl: '#FECBF0', cd: '#E994D2', w: 42, h: 28, r: -12, x: 50, y: 540 },
  { c: '#cd9af3', cl: '#E4C7F8', cd: '#BD8EE0', w: 38, h: 26, r: 6, x: 440, y: 610 },
  { c: '#fec588', cl: '#FEDFBE', cd: '#EAB57D', w: 50, h: 32, r: -6, x: 36, y: 612 },
];
const vars = (b: (typeof BLOCKS)[number]) =>
  [`--c:${b.c}`, `--cl:${b.cl}`, `--cd:${b.cd}`, `--w:${b.w}px`, `--h:${b.h}px`, `--r:${b.r}deg`, `--x:${b.x}px`, `--y:${b.y}px`]
    .concat(b.mx ? [`--mx:${b.mx}`, `--mw:${b.mw}px`, `--mh:${b.mh}px`] : [])
    .join(';');
---

<div class="hero-decor" aria-hidden="true">
  {BLOCKS.map((b) => <span class="hero-block" style={vars(b)} />)}
</div>
