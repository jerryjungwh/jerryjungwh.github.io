---
import { siteStrings } from '../data/site';
import type { Lang, Review } from '../lib/types';

interface Props {
  lang: Lang;
}

const t = siteStrings(Astro.props.lang).reviews;
const quote = (r: Review) => ({ text: r.text, caption: t.caption(r.year, r.month) });
---

<p class="doc-text">{t.lead}</p>

<div class="reviews">
  {
    t.items.map(quote).map((r) => (
      <figure>
        <blockquote>
          <p>{r.text}</p>
        </blockquote>
        <figcaption>{r.caption}</figcaption>
      </figure>
    ))
  }
</div>

<h3>{t.shipped.heading}</h3>

<div class="reviews">
  {
    t.shipped.groups.map((g) => (
      <div class="shipped-group">
        {g.reviews.map(quote).map((r) => (
          <figure>
            <blockquote>
              <p>{r.text}</p>
            </blockquote>
            <figcaption>{r.caption}</figcaption>
          </figure>
        ))}
        <div class="shipped-note">
          <p class="shipped-when">
            <strong>{t.shipped.label}</strong> <span>{g.when}</span>
          </p>{' '}
          <p>{g.note}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .reviews {
    display: grid;
    gap: 36px;
    max-width: 760px;
    margin-top: clamp(24px, 3vw, 36px);
  }
  h3 {
    margin-top: clamp(56px, 7vw, 88px);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  blockquote {
    margin: 0;
    padding-left: 18px;
    border-left: 3px solid var(--brand);
    font-size: clamp(17px, 1.7vw, 21px);
    font-weight: 500;
    line-height: 1.65;
    /* No single mark left alone on the last line. */
    text-wrap: pretty;
  }
  figcaption {
    margin-top: 10px;
    padding-left: 21px;
    font-size: 14px;
    color: var(--body);
  }
  .shipped-group {
    display: grid;
    gap: 22px;
  }
  /* The answer to the request above it: starts where the quoted text starts. */
  .shipped-note {
    margin-left: 21px;
    padding: 14px 18px;
    border-radius: 12px;
    background: var(--brand-tint);
    font-size: clamp(15px, 1.3vw, 16px);
    line-height: 1.65;
  }
  .shipped-when {
    font-size: 14px;
    color: var(--body);
  }
  .shipped-when strong {
    margin-right: 6px;
    font-weight: 700;
    color: var(--brand);
  }
</style>
