---
import { siteStrings } from '../data/site';
import type { Lang } from '../lib/types';

interface Props {
  lang: Lang;
}

const t = siteStrings(Astro.props.lang).reviews;
const lists = [
  { intro: undefined, reviews: t.items },
  { intro: t.shipped, reviews: t.shipped.reviews },
];
---

{
  lists.map(({ intro, reviews }) => (
    <>
      {intro && <h3>{intro.heading}</h3>}
      {intro && <p class="doc-text">{intro.intro}</p>}
      <div class="reviews">
        {reviews.map((r) => (
          <figure>
            <blockquote>
              <p>{r.text}</p>
            </blockquote>
            <figcaption>{t.caption(r.year, r.month)}</figcaption>
          </figure>
        ))}
      </div>
    </>
  ))
}

<style>
  .reviews {
    display: grid;
    gap: 36px;
    max-width: 760px;
  }
  h3 {
    margin-top: clamp(56px, 7vw, 88px);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  h3 + p {
    margin-top: 12px;
  }
  p + .reviews {
    margin-top: clamp(24px, 3vw, 36px);
  }
  blockquote {
    margin: 0;
    padding-left: 18px;
    border-left: 3px solid var(--brand);
    font-size: clamp(17px, 1.7vw, 21px);
    font-weight: 500;
    line-height: 1.65;
    /* No single mark left alone on the last line. */
    text-wrap: pretty;
  }
  figcaption {
    margin-top: 10px;
    padding-left: 21px;
    font-size: 14px;
    color: var(--body);
  }
</style>
