---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/doc.css';

import { IS_RELEASE, robotsFor } from '../lib/release';
import { pageJsonLd, pageMeta } from '../lib/seo';
import { CASE_ORDER, type CaseId, type FaqItem, type Lang, type PageKey } from '../lib/types';
import { EUROPE_EXTRA_ZONES, GTM_ID } from '../data/measurement';
import { alternates, pageLabel, pagePath } from '../lib/urls';
import ConsentBanner from './ConsentBanner.astro';
import JsonLd from './JsonLd.astro';

interface Props {
  lang: Lang;
  /** A page of the site: title, description, canonical, hreflang and structured data follow from it. */
  page?: PageKey;
  /** The questions this page shows as its own list (case pages, the questions page). */
  faq?: FaqItem[];
  /** Pages with a case stepper: 'random' picks the start case per visit, a case id fixes it. */
  stepper?: 'random' | CaseId;
  /** The not-found page: no `page`, its own title and text, kept out of search. */
  notFound?: { title: string; description: string };
}

const { lang, page, faq, stepper, notFound } = Astro.props;
if (!page && !notFound) throw new Error('Layout: page 또는 notFound가 필요하다');
const meta = page ? pageMeta(lang, page) : notFound!;
const canonical = page ? new URL(pagePath(lang, page), Astro.site).href : undefined;
const alt = page ? alternates(page) : undefined;
const jsonLd = page ? pageJsonLd(lang, page, faq) : [];
const robots = robotsFor({ release: IS_RELEASE, notFound: !page });
// Runs before the first paint, so the stepper never shows one case and then jumps to another.
// If the stepper script has not attached after 3 seconds, the page goes back to the plain document.
const stepperBoot = `(function(){var d=document.documentElement,c=${JSON.stringify(CASE_ORDER)};d.classList.add('js');if(!d.dataset.startCase)d.dataset.startCase=c[Math.floor(Math.random()*c.length)];setTimeout(function(){if(!document.querySelector('[data-stepper][data-ready]'))d.classList.remove('js')},3000)})();`;
// The page's own label, read by the script that writes where a visit came from into the Play links.
const pageName = page ? pageLabel(page) : 'notfound';
// The container decides the consent default by the visitor's IP; this page can only see the browser's
// time zone. Where they disagree — a European time zone on an address the container does not read as
// European — the banner would promise that nothing is collected while the tag collected it anyway.
// So the page sets its own default first, before the container loads. Either signal holds it back.
const consentBoot = `(function(){var d=document.documentElement,z;try{z=Intl.DateTimeFormat().resolvedOptions().timeZone}catch(e){return}if(!z||(z.indexOf('Europe/')!==0&&${JSON.stringify(EUROPE_EXTRA_ZONES)}.indexOf(z)<0))return;d.dataset.consentNeeded='';try{if(localStorage.getItem('simganpyo.consent')==='granted')return}catch(e){}window.dataLayer=window.dataLayer||[];function g(){dataLayer.push(arguments)}g('consent','default',{analytics_storage:'denied',wait_for_update:500})})();`;
// Google Tag Manager, as its own install screen prints it, as high in <head> as the metadata allows.
// Never deferred: a container loaded after a click loses what brought the visit in.
const gtmBoot = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`;
---

<!doctype html>
<html
  lang={lang}
  data-lang={lang}
  data-page={pageName}
  data-start-case={stepper && stepper !== 'random' ? stepper : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {robots && <meta name="robots" content={robots} />}
    {
      canonical && alt && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="ko" href={alt.ko} />
          <link rel="alternate" hreflang="en" href={alt.en} />
          <link rel="alternate" hreflang="x-default" href={alt.xDefault} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="심간표 SimpleScheduler" />
          <meta property="og:title" content={meta.title} />
          <meta property="og:description" content={meta.description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
        </>
      )
    }
    {/* Naver checks ownership by this tag. Public token, not a secret. Naver asks again every year. */}
    <meta name="naver-site-verification" content="782139bf34c7e21f82e414f27f0a6664072040e7" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {GTM_ID && <script is:inline set:html={consentBoot} />}
    {GTM_ID && <script is:inline set:html={gtmBoot} />}
    {jsonLd.map((data) => <JsonLd data={data} />)}
    {stepper && <script is:inline set:html={stepperBoot} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
    <ConsentBanner lang={lang} />
    <script>
      import { startMeasurement } from './measurement.client';

      startMeasurement();
    </script>
  </body>
</html>
